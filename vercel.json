{
  "version": 2,
  "functions": {
    "api/**/*.ts": {
      "includeFiles": "firebase-applet-config.json",
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/api/generate-question", "destination": "/api/generate-question.ts" },
    { "source": "/api/admin/test-gemini-key", "destination": "/api/admin/test-gemini-key.ts" },
    { "source": "/api/(.*)", "destination": "/api/index.ts" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
